{
  "name": "ai-chat-search",
  "displayName": "AI Chat Search",
  "description": "Search and navigate AI chat history from Cursor, Cline, Continue, Copilot and more",
  "version": "0.2.1",
  "publisher": "ai-chat-tools",
  "repository": {
    "type": "git",
    "url": "https://github.com/sweetorange2022/AI-Chat-Search.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:aiChatSearch.search",
    "onCommand:aiChatSearch.refreshIndex"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiChatSearch.search",
        "title": "Search AI Chat History",
        "icon": "$(search)"
      },
      {
        "command": "aiChatSearch.refreshIndex",
        "title": "Refresh AI Chat Index",
        "icon": "$(refresh)"
      }
    ],
    "keybindings": [
      {
        "command": "aiChatSearch.search",
        "key": "ctrl+shift+;",
        "mac": "cmd+shift+;"
      }
    ],
    "configuration": {
      "title": "AI Chat Search",
      "properties": {
        "aiChatSearch.providers.cline.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Cline chat history search"
        },
        "aiChatSearch.providers.cline.dataPath": {
          "type": "string",
          "default": "",
          "description": "Custom Cline data path (auto-detected if empty)"
        },
        "aiChatSearch.providers.continue.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Continue chat history search"
        },
        "aiChatSearch.providers.continue.dataPath": {
          "type": "string",
          "default": "",
          "description": "Custom Continue data path (auto-detected if empty)"
        },
        "aiChatSearch.providers.cursor.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Cursor native chat history search"
        },
        "aiChatSearch.providers.cursor.dataPath": {
          "type": "string",
          "default": "",
          "description": "Custom Cursor User directory or state.vscdb path (auto-detected if empty)"
        },
        "aiChatSearch.providers.cursor.maxSessions": {
          "type": "number",
          "default": 10,
          "description": "Maximum Cursor conversations to index (0 = unlimited)"
        },
        "aiChatSearch.providers.copilot.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Copilot Chat history search"
        },
        "aiChatSearch.providers.copilot.dataPath": {
          "type": "string",
          "default": "",
          "description": "Custom Code User directory path for Copilot data (auto-detected if empty)"
        },
        "aiChatSearch.maxResults": {
          "type": "number",
          "default": 50,
          "description": "Maximum search results to display"
        },
        "aiChatSearch.contextLines": {
          "type": "number",
          "default": 3,
          "description": "Number of context lines around each match"
        }
      }
    }
  },
  "scripts": {
"build": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:node:sqlite --external:better-sqlite3 --format=cjs --platform=node --minify-syntax --minify-whitespace --tree-shaking=false && node scripts/copy-wasm.js",
    "watch": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:node:sqlite --format=cjs --platform=node --sourcemap --watch",
    "prewatch": "node scripts/copy-wasm.js",
    "lint": "tsc --noEmit",
    "package": "npm run build && vsce package --allow-missing-repository --no-dependencies"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.19.11",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "markdown-it": "^14.2.0",
    "sql.js": "^1.12.0"
  }
}
